# ==============================================================================
# Riyadah Elite Client Environment Template (.env.example)
# Copy to client/.env for local development:
#   cp .env.example .env
# Note: Variables prefixed with VITE_ are exposed to the client-side browser bundle.
# NEVER place database passwords, private keys, or server secrets in this file.
# ==============================================================================

# Backend API Base URL
VITE_API_URL=http://localhost:5000/api/v1
