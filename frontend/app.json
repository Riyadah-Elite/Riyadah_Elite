{
  "expo": {
    "name": "Riyadah Elite",
    "slug": "riyadah-elite",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./public/assets/generated/characters/tariq-kestrel-playtester.png",
    "scheme": "riyadah-elite",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.riyadahelite.app"
    },
    "android": {
      "package": "com.riyadahelite.app",
      "adaptiveIcon": {
        "backgroundColor": "#0B0D12"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "bundler": "metro",
      "favicon": "./public/assets/generated/characters/tariq-kestrel-playtester.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B0D12"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
