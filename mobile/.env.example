# Riyadah Elite Mobile Client Environment Configuration (.env.example)
# Public variables only — DO NOT add backend infrastructure credentials, private keys, or passwords.

# API Base URL (Point to your development host machine or Render production API)
# Development (Android Emulator uses 10.0.2.2, Physical device uses LAN IP e.g. 192.168.1.X)
EXPO_PUBLIC_API_URL="http://localhost:5000/api/v1"

# Production API:
# EXPO_PUBLIC_API_URL="https://riyadah-elite-backend.onrender.com/api/v1"
