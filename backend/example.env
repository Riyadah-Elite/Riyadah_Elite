PORT=5000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/game?schema=public // for local 
DATABASE_URL=your_connection_string/game ?sslmode=require // for neon db
JWT_SECRET=Your_Secret
JWT_EXPIRES_IN=1d
CORS_ORIGIN=*
NODE_ENV=production

# ---- Logging ----
# debug | info | warn | error — anything below this is dropped
LOG_LEVEL=info

# ---- Object storage (docker compose up -d minio) ----
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=game
S3_USE_SSL=false