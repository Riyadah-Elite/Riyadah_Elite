datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

// Initial baseline model for connection and schema verification
model HealthCheck {
  id        String   @id @default(uuid())
  status    String
  createdAt DateTime @default(now())
}

enum Role {
  PLAYER
  DEVELOPER
  HOST
  ADMIN
}

model User {
  id                      String                   @id @default(uuid())
  fullName                String
  username                String                   @unique
  email                   String                   @unique
  passwordHash            String
  role                    Role                     @default(PLAYER)
  isVerified              Boolean                  @default(false)
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  resetTokens             PasswordResetToken[]
  profile                 PlayerProfile?
  applications            GameTestingApplication[]
  tournamentRegistrations TournamentRegistration[]
  bugReports              BugReport[]
  files                   FileMedia[]

  @@index([email])
  @@index([username])
  @@index([role])
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([tokenHash])
}

model PlayerProfile {
  id               String   @id @default(uuid())
  userId           String   @unique
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bio              String?
  country          String?  @default("Saudi Arabia")
  city             String?  @default("Riyadh")
  primaryPlatform  String?  @default("PC Windows")
  favoriteGenres   String[] @default(["FPS", "Tactical Shooter"])
  hardwareGpu      String?
  hardwareCpu      String?
  hardwareRam      String?
  hardwareOs       String?
  testerScore      Int      @default(0)
  totalGamesTested Int      @default(0)
  avatarUrl        String?
  discordHandle    String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([userId])
}

model Category {
  id            String            @id @default(uuid())
  name          String            @unique
  slug          String            @unique
  description   String?
  isActive      Boolean           @default(true)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  opportunities GameOpportunity[]

  @@index([slug])
  @@index([isActive])
}

enum OpportunityStatus {
  DRAFT
  ACTIVE
  PAUSED
  CLOSED
}

model GameOpportunity {
  id                 String                   @id @default(uuid())
  slug               String                   @unique
  title              String
  studio             String
  genre              String
  platform           String
  stage              String                   @default("Beta")
  version            String?
  description        String
  focusAreas         String[]                 @default([])
  requirements       String[]                 @default([])
  capacity           Int                      @default(100)
  rewardText         String?
  imageUrl           String?
  externalLink       String?
  compensationAmount Decimal?                 @db.Decimal(10, 2)
  currency           String?                  @default("SAR")
  status             OpportunityStatus        @default(ACTIVE)
  startDate          DateTime?
  endDate            DateTime?
  categoryId         String?
  category           Category?                @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt
  applications       GameTestingApplication[]
  bugReports         BugReport[]

  @@index([slug])
  @@index([status])
  @@index([studio])
  @@index([categoryId])
}

enum ApplicationStatus {
  PENDING
  UNDER_REVIEW
  ACCEPTED
  REJECTED
  COMPLETED
}

model GameTestingApplication {
  id                String            @id @default(uuid())
  userId            String
  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  opportunityId     String
  opportunity       GameOpportunity   @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  status            ApplicationStatus @default(PENDING)
  platform          String
  primaryGames      String[]          @default([])
  hardwareGpu       String
  hardwareCpu       String
  hardwareRam       String
  availabilityHours String
  experienceNotes   String?
  agreedNda         Boolean           @default(false)
  agreedTelemetry   Boolean           @default(false)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@unique([userId, opportunityId])
  @@index([userId])
  @@index([opportunityId])
  @@index([status])
}

enum BugSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum BugStatus {
  OPEN
  INVESTIGATING
  CONFIRMED
  RESOLVED
  WONT_FIX
}

model BugReport {
  id                String          @id @default(uuid())
  userId            String
  user              User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  opportunityId     String
  opportunity       GameOpportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  title             String
  summary           String?
  description       String
  severity          BugSeverity     @default(MEDIUM)
  status            BugStatus       @default(OPEN)
  reproductionSteps String?
  systemSpecs       Json?
  mediaUrls         String[]        @default([])
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([userId])
  @@index([opportunityId])
  @@index([status])
  @@index([severity])
}

model FileMedia {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  filename    String
  storageKey  String
  url         String
  mimeType    String
  size        Int
  fileType    String   @default("EVIDENCE") // AVATAR, EVIDENCE, BANNER, DOCUMENT
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@index([fileType])
}

enum TournamentStatus {
  DRAFT
  REGISTRATION_OPEN
  REGISTRATION_CLOSED
  ONGOING
  COMPLETED
  CANCELLED
}

enum RegistrationMode {
  SOLO
  EXISTING_TEAM
  NEW_TEAM
}

enum RegistrationStatus {
  CONFIRMED
  WAITLISTED
  CHECKED_IN
  WITHDRAWN
  DISQUALIFIED
}

model Tournament {
  id                   String                   @id @default(uuid())
  slug                 String                   @unique
  title                String
  game                 String
  organizer            String
  format               String
  bracketType          String                   @default("Single Elimination")
  platform             String                   @default("PC")
  region               String                   @default("Middle East / MENA")
  prizePool            String?
  prizeAmount          Decimal?                 @db.Decimal(10, 2)
  currency             String?                  @default("SAR")
  entryFee             String                   @default("Free")
  teamSize             Int                      @default(5)
  maxParticipants      Int                      @default(64)
  registrationDeadline DateTime?
  startDate            DateTime
  endDate              DateTime?
  rules                String[]
  description          String
  bannerUrl            String?
  discordUrl           String?
  externalLink         String?
  status               TournamentStatus         @default(REGISTRATION_OPEN)
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt
  registrations        TournamentRegistration[]

  @@index([slug])
  @@index([status])
  @@index([game])
  @@index([organizer])
  @@index([registrationDeadline])
}

model TournamentRegistration {
  id               String             @id @default(uuid())
  tournamentId     String
  tournament       Tournament         @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  userId           String
  user             User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  registrationMode RegistrationMode   @default(SOLO)
  status           RegistrationStatus @default(CONFIRMED)
  inGameHandle     String
  preferredRoles   String[]
  teamName         String?
  discordHandle    String?
  agreedRules      Boolean            @default(true)
  agreedAntiCheat  Boolean            @default(true)
  ticketCode       String             @unique @default(uuid())
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@unique([userId, tournamentId])
  @@index([userId])
  @@index([tournamentId])
  @@index([status])
}

model PlatformSetting {
  id          String   @id @default(uuid())
  key         String   @unique
  value       Json
  description String?
  updatedAt   DateTime @updatedAt

  @@index([key])
}

model AdminAuditLog {
  id         String   @id @default(uuid())
  actorId    String
  action     String
  entityType String
  entityId   String?
  reason     String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([actorId])
  @@index([action])
  @@index([entityType])
  @@index([createdAt])
}
