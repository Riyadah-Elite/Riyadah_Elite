# ==============================================================================
# Riyadah Elite Server Environment Template (.env.example)
# Copy to server/.env for local development:
#   cp .env.example .env
# This file is strictly for backend and Prisma runtime configuration.
# NEVER commit production passwords or sensitive secrets to source control.
# ==============================================================================

# Server Environment & Port
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# PostgreSQL / Prisma Database Connection Strings (Neon)
# DATABASE_URL: Pooled connection string (for queries & application server runtime)
# DIRECT_URL: Direct unpooled connection string (for migrations & schema pushes)
DATABASE_URL="postgresql://user:password@ep-xyz-pooler.region.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://user:password@ep-xyz.region.aws.neon.tech/neondb?sslmode=require"

# Authentication Security (JWT)
JWT_SECRET="replace_with_a_secure_random_secret_at_least_32_characters"
JWT_EXPIRES_IN="7d"

# Email Provider Configuration (Optional / Development fallback)
SMTP_HOST="smtp.example.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="apikey_or_user"
SMTP_PASS="secret_password_or_token"
SMTP_FROM="Riyadah Elite <security@riyadahelite.com>"

# ==============================================================================
# INFRASTRUCTURE SERVICES (MinIO / Redis / RabbitMQ)
# ==============================================================================

# Object Storage (MinIO / S3 Compatible)
MINIO_ENDPOINT="localhost"
MINIO_PORT=9000
MINIO_ACCESS_KEY="minioadmin"
MINIO_SECRET_KEY="minioadmin"
MINIO_USE_SSL=false
MINIO_BUCKET="riyadah-media"
MINIO_REGION="us-east-1"
MINIO_PUBLIC_URL="http://localhost:9000/riyadah-media"

# In-Memory Cache (Redis)
# Provide either REDIS_URL or host/port
REDIS_URL="redis://localhost:6379"
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_PASSWORD=""

# Asynchronous Message Broker (RabbitMQ)
# Provide either RABBITMQ_URL or individual host/port credentials
RABBITMQ_URL="amqp://guest:guest@localhost:5672"
RABBITMQ_HOST="localhost"
RABBITMQ_PORT=5672
RABBITMQ_USER="guest"
RABBITMQ_PASSWORD="guest"

