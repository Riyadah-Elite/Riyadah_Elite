# ==============================================================================
# Riyadah Elite Monorepo Environment Variables Template
# Copy this file to .env in local development:
#   cp .env.example .env (or in client/ and server/ as required)
# ==============================================================================

# Backend (server)
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# PostgreSQL / Prisma Database URL (server)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/riyadah_elite?schema=public"

# Authentication Security (server)
JWT_SECRET="replace_with_a_secure_random_secret_at_least_32_characters"
JWT_EXPIRES_IN="7d"

# Email Provider Configuration (server)
# In development, if SMTP is not configured, password reset URLs are logged to console
# and returned safely via a development-only payload field (never in production).
# For production email delivery, configure SMTP credentials:
SMTP_HOST="smtp.example.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="apikey_or_user"
SMTP_PASS="secret_password_or_token"
SMTP_FROM="Riyadah Elite <security@riyadahelite.com>"

# Frontend (client)
# Note: Vite client environment variables must start with VITE_
VITE_API_URL=http://localhost:5000/api/v1

